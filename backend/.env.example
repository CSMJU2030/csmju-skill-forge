# ---------------------------------------------------------------------------
# csmju-skillforge - backend environment
# Copy to .env "before" running `pnpm install` (never commit .env)
# Values below the separator are Core's frozen contract for this subsystem —
# do not change them yourself; everything above/below that is ours to set.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3002

# This subsystem's own database only — never point this at core_hub's DB
# (Database-per-Subsystem rule). Matches docker-compose.yml's port mapping.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/csmju_skillforge

# Core Hub (identity provider) — frozen contract, do not change
CORE_HUB_URL=http://localhost:3000
CORE_HUB_JWKS_URL=http://localhost:3000/api/v1/.well-known/jwks.json
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

# This subsystem's identity — must match `name:` in standards/subsystem.yaml
# and the Subsystem Registry entry Core approved
SUBSYSTEM_ID=csmju-skillforge

# JWKS cache (passed straight through to jose's createRemoteJWKSet — see
# src/auth/jwks.service.ts)
JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000
JWT_CLOCK_TOLERANCE_SEC=5

# ---------------------------------------------------------------------------
# Below this line: additions specific to this subsystem, not part of Core's
# contract above.
# ---------------------------------------------------------------------------

# Persistent user-supplied AI API keys are encrypted with AES-256-GCM.
# Generate a unique 32-byte key (64 hex characters), keep it stable, and never
# commit the real value. Changing it makes previously saved keys unreadable.
LLM_CREDENTIALS_ENCRYPTION_KEY=""

# Local-dev only: when true, any request with NO Authorization header (i.e.
# not yet sitting behind a real Core Hub session) is treated as this fake
# identity instead of getting a 401. Set DEV_ROLE=staff to test the course
# admin screens locally. Must be false/unset once this sits behind Core.
DEV_IDENTITY_FALLBACK=true
DEV_USERNAME=6xxxxxxxxx-dev
DEV_ROLE=student
DEV_FACULTY=science
