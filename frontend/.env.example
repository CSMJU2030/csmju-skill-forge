# Copy to .env "before" running `pnpm install` (never commit .env).

# This subsystem's own backend (not the Core Hub directly).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002/api/v1

# There is nothing else to set here for local dev: the backend's own
# DEV_IDENTITY_FALLBACK (see backend/.env.example) stands in for a real Core
# Hub session while there's no Authorization token to forward yet. To test
# as a staff/admin account locally, set DEV_ROLE=staff in backend/.env.
