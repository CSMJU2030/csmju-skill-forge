{
  "name": "csmju-skillforge-backend",
  "version": "1.0.0",
  "description": "CSMJU2030 subsystem: AI Career Skill Analyzer & Portfolio Builder (SkillForge) - backend",
  "packageManager": "pnpm@9.9.0",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "node -r ts-node/register --test test/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "5.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "jose": "^4.15.9",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.5",
    "eslint": "^9.35.0",
    "prisma": "5.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.46.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "allowScripts": {
    "prisma@5.19.0": true,
    "@nestjs/core@10.4.22": true,
    "@prisma/engines@5.19.0": true,
    "@prisma/client@5.19.0": true
  }
}
